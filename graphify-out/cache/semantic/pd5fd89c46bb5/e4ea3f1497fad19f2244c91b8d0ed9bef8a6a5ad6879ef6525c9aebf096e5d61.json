{"nodes": [{"id": "readme_naaf_project", "label": "NAAF Implementation (BCSE497J Project-I)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_naaf_paper", "label": "Neural-Attentive Capacity Assignment: A Hybrid Paradigm for Sybil-Resilient Governance in Decentralized Information Systems", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sumup", "label": "SumUp (Tran et al. 2009)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baseline vote-aggregation scheme via ticket distribution; capacity = 1 + tickets. NAAF builds on its capacities."}, {"id": "readme_ticket_distribution", "label": "SumUp Ticket Distribution", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS from collector, uniform split of remaining tickets per level, capacity = 1 + tickets."}, {"id": "readme_exact_max_flow", "label": "Exact Max-Flow Evaluation (networkx)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used instead of SumUp's greedy approximation because the ~4,239-node graph is small enough; isolates capacity-assignment policy from search-approximation noise."}, {"id": "readme_sybilrank", "label": "SybilRank (Cao et al. 2012)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Early-terminated power iteration of trust from honest seeds plus degree normalization; evaluated by ROC-AUC (0.592 dense, 0.705 sparse)."}, {"id": "readme_degree_normalization", "label": "SybilRank Degree Normalization", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partly cancels real signal on dense scenario because the Sybil cluster is high-degree (raw AUC 0.868 vs normalized 0.592); reverses in sparse scenario."}, {"id": "readme_gatv2_attention_layer", "label": "GATv2 Attention Layer (NaafGATv2)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2-layer GATv2Conv, hidden 8, 4 heads, features [normalized degree, revealed label]; semi-supervised on 20% revealed subset. Fair AUC 0.914 dense / 0.853 sparse."}, {"id": "readme_sybilgat", "label": "SybilGAT", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of the standard 8-attack-edges-per-Sybil synthetic setting and the upper-bound evaluation setup."}, {"id": "readme_fair_variant", "label": "Fair Variant (honest-only seeds)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only honest labels revealed, matching SybilRank's real-world constraint; the legitimate comparison point."}, {"id": "readme_upper_bound_variant", "label": "Upper-Bound Variant (Sybil labels revealed)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some Sybil labels revealed, realistic only with moderator-confirmed accounts; AUC 1.000 dense flagged as an easy setting."}, {"id": "readme_attention_vs_trust_finding", "label": "Attention Weight Is Not Trust (higher on attack edges)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean attention higher on attack edges (0.046) than honest (0.021); raw attention would amplify attack edges, so NAAF scales by (1 - P(Sybil)) instead."}, {"id": "readme_naaf_fusion", "label": "NAAF Fusion: capacity_SumUp * (1 - P(Sybil|v))", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines SumUp ticket capacities with GATv2 Sybil probability. Dense: 53.76% attacker reduction at -17.37pp honest cost; sparse: only 0.44% reduction."}, {"id": "readme_naaf_v2_threshold_gated", "label": "NAAF v2 Threshold-Gated (P(Sybil) > 0.5)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only penalizes edges when P(Sybil) > 0.5; never fires in sparse regime."}, {"id": "readme_ablation_alpha_sweep", "label": "Capacity-Formula Ablation (alpha sweep)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C = C_sumup * (1 - alpha * P_sybil); roughly linear trade-off, no free lunch."}, {"id": "readme_dense_scenario", "label": "Dense Sybil Scenario (200 Sybils, 1,600 attack edges)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sparse_scenario", "label": "Sparse Sybil Scenario (25 Sybils, 200 attack edges)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests the sparse-cut regime the base papers' guarantees assume; reduces Sybil count rather than tuning attack edges per Sybil or internal density."}, {"id": "readme_sybil_injection", "label": "Synthetic Sybil Cluster Injection (Erdos-Renyi p=0.3)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attack edges kept at 8 per Sybil (SybilGAT standard); internal density free for attacker."}, {"id": "readme_attack_edges", "label": "Attack Edges", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sparse_cut_assumption", "label": "Sparse-Cut Assumption", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SybilRank/SumUp guarantees assume a limited number of attack edges relative to honest population."}, {"id": "readme_locked_evaluation_protocol", "label": "Locked Evaluation Protocol", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Median-degree collector, C_max=1000, 200 honest voters (seed 42), all Sybil voters, 1 vote cap; fixed so all methods are compared apples-to-apples."}, {"id": "readme_median_degree_collector", "label": "Median-Degree Collector Selection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Max-degree hub (degree 1,045 vs median 26) was an unrepresentative outlier."}, {"id": "readme_class_imbalance_calibration", "label": "Class-Imbalance Probability Compression", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With 0.6% positive rate, max P(Sybil) is 0.022 so (1-P) fusion is a near no-op despite good ranking (AUC 0.853)."}, {"id": "readme_percentile_rank_scaling", "label": "Percentile-Rank Scaling of P(Sybil)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes sparse no-op (56.67% reduction) but overcorrects dense (93.43% reduction, -33.49pp honest); not a universal fix."}, {"id": "readme_naaf_option_a", "label": "NAAF Option A: Source/Voter-Level Trust Weighting", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "capacity(SOURCE->voter) = 1*(1-P(Sybil|voter)); preserves SumUp's bound; cannot be routed around by a dense Sybil cluster. Dense: 61.42% reduction at ~free honest cost."}, {"id": "readme_naaf_option_b", "label": "NAAF Option B: Suspicious-Boundary Edge Throttling", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throttle only edges to confidently-flagged nodes (P > tau_hi). Dense: false positives on central min-cut edges reproduce v1's honest damage; sparse: exact no-op."}, {"id": "readme_naaf_option_c", "label": "NAAF Option C: Confidence-Gated Variant of A", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dense: 100% attacker suppression at -0.31pp honest; sparse: ~0.7% reduction."}, {"id": "readme_tau_hi_calibration", "label": "tau_hi Boundary Threshold Calibration", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "99th percentile of P(Sybil) among revealed-honest training nodes, per scenario; fixed 0.8 rejected since sparse max P is ~0.022. No Sybil ground truth used."}, {"id": "readme_md5_file_locking", "label": "Byte-for-Byte (md5) Locked-File Verification", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_snap_ego_facebook", "label": "SNAP ego-Facebook Graph (McAuley & Leskovec, NIPS 2012)", "file_type": "paper", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4,039 nodes, 88,234 edges, connected, average degree 43.691."}, {"id": "readme_honest_collection_rate", "label": "Honest Collection Rate", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_attacker_capacity_per_attack_edge", "label": "Attacker Capacity per Attack Edge", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_step10_primary_formulation_decision", "label": "Step 10: Choose Primary Formulation (A vs B)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open decision: fix B's false-positive problem or reframe A as primary with B/C as ablations."}], "edges": [{"source": "readme_naaf_project", "target": "readme_naaf_paper", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_naaf_project", "target": "reproduce_reproducibility_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source